{
  "name": "@orbitops/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
